# === WhatsApp Cloud API (required) ===
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=super-secret-verify-token-123

# === LLM Providers (provide at least one) ===
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# === Pinecone Vector DB ===
PINECONE_API_KEY=
PINECONE_INDEX_NAME=whatsapp-rag

# === Database ===
DATABASE_URL=sqlite:///instance/database.db
# For production Postgres example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/whatsapp_ai

# === Flask / App ===
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string
LOG_LEVEL=INFO

# === Optional RAG tuning ===
RAG_TOP_K=3
CHUNK_SIZE=1000
